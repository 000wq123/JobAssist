# Copy this to .env.local

# Backend URL (leave empty for local dev with Vite proxy)
# Set to your deployed API URL for production, e.g. https://jobassist-production.up.railway.app/api
VITE_API_URL=

# Sentry error tracking (optional — leave empty to disable)
VITE_SENTRY_DSN=

# App version injected into Sentry releases (optional)
VITE_APP_VERSION=
